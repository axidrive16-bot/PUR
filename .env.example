# Public app URL used by Stripe redirect and portal sessions.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser/server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional compatibility with @supabase/ssr helpers if you migrate fully to publishable keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Financial Modeling Prep. If omitted, the app uses demo market data.
FMP_API_KEY=

# Stripe Premium subscription.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
